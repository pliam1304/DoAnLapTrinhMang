# =====================================================================
# CẤU HÌNH MÔI TRƯỜNG MẪU CHO NEGA
# Sao chép tệp này thành ".env" để cấu hình bảo mật cục bộ.
# Lưu ý: Tệp ".env" đã được liệt kê trong .gitignore và KHÔNG bị đẩy lên GitHub.
# =====================================================================

# Cổng mạng sử dụng
NEGA_UDP_PORT=9999
NEGA_TCP_PORT=8888
NEGA_HTTP_PORT=5050

# Địa chỉ lắng nghe HTTP Dashboard (0.0.0.0 cho phép truy cập qua LAN, 127.0.0.1 chỉ nội bộ máy)
NEGA_BIND_HOST=0.0.0.0

# Tên hiển thị của Server trên Dashboard (khi bật ẩn danh máy chủ)
NEGA_SERVER_NAME=NEGA-LAB-SERVER

# Mã PIN quản trị khi truy cập Dashboard từ máy khác trong LAN (để trống = tự sinh ngẫu nhiên mỗi lần bật)
NEGA_ADMIN_PIN=

# Nếu đặt true, ngay cả trình duyệt mở từ localhost cũng phải nhập PIN
NEGA_REQUIRE_PIN_ON_LOCALHOST=false

# Khóa bí mật chung của phòng máy (bật xác thực HMAC-SHA256 cho gói tin UDP DISCOVER/ANNOUNCE & TCP Handshake).
# Để trống nếu muốn chạy chế độ Dev mở; khi đặt giá trị, cả Server và Agent phải dùng cùng khóa này.
NEGA_CLUSTER_KEY=

# Cổng an toàn hệ điều hành (Khuyến nghị giữ false khi dev/test; chỉ đặt true trên phòng máy demo thật)
NEGA_ALLOW_REAL_SHUTDOWN=false
NEGA_ALLOW_OS_CAPTURE=false

# Ẩn tên máy tính & tên đăng nhập thật của hệ điều hành khỏi logs/giao diện
NEGA_MASK_HOST_IDENTITY=true

# Số lượng máy trạm giả lập mặc định khi khởi động Server (0..16)
NEGA_DEFAULT_SIMULATED_COUNT=5
